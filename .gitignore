# Build output
/build*/

# Locally unpacked Qt development files (see tools/setup-qt-local.sh)
/.deps/

# Original WinAPE distribution, kept as a reference only. It holds third-party
# binaries and the Amstrad ROM images, which are not ours to version.
/WinAPE20B2/

# Test programs downloaded on demand (see tests/fetch-test-roms.sh)
/tests/roms/

# Third-party reference documents (see tools/fetch-references.sh)
/reference/

# Software for the emulated machine (games, demos) is not ours to version.
# A test fixture that must be kept can be added with `git add -f`.
*.dsk
*.DSK
*.sna
*.SNA
*.cdt
*.CDT
*.cpr
*.CPR

CMakeUserPresets.json
